#!/usr/bin/env bash
# Make git actually run this repo's tracked .githooks.
#
# git runs exactly ONE hooks directory: core.hooksPath when set, otherwise
# $GIT_DIR/hooks. Tracking hooks in .githooks/ does nothing on its own, and the
# failure is silent — `git commit` and `git push` both still succeed while the
# documented gates never fire (gascity-jiao).
#
# Two shapes, decided by who owns core.hooksPath:
#
#   nobody owns it  -> point core.hooksPath at .githooks.
#   another tool    -> install a FORWARDER for each tracked hook in the
#                      directory that tool owns. beads installs its dolt-sync
#                      hooks (post-checkout, post-merge, prepare-commit-msg)
#                      into .beads/hooks and points core.hooksPath there;
#                      repointing would disable them. A forwarder execs the
#                      tracked hook, so the two cannot drift apart — which is
#                      exactly what copies did here: the copies that ran had
#                      lost the pre-push bead-ownership guard and the
#                      pre-commit OpenAPI drift guards entirely.
#
# Idempotent: re-running installs the same forwarder byte for byte.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
tracked_dir="$repo_root/.githooks"
forwarder_marker="gascity-hook-forwarder:"
managed_begin='# --- BEGIN BEADS INTEGRATION'
managed_end='# --- END BEADS INTEGRATION'

if [ ! -d "$tracked_dir" ]; then
  echo "install-git-hooks: no .githooks/ in $repo_root — nothing to install" >&2
  exit 0
fi

canonical() {
  # Resolve a directory for comparison; fall back to the literal path when it
  # does not exist yet.
  (cd "$1" 2>/dev/null && pwd -P) || printf '%s\n' "$1"
}

hooks_dir="$(git rev-parse --git-path hooks)"
case "$hooks_dir" in
  /*) ;;
  *) hooks_dir="$repo_root/$hooks_dir" ;;
esac

if [ "$(canonical "$hooks_dir")" = "$(canonical "$tracked_dir")" ]; then
  echo "install-git-hooks: core.hooksPath already resolves to .githooks — nothing to do"
  exit 0
fi

# Does anything already live in the resolved hooks directory? git ships
# *.sample files there; those are inert and do not count as an owner.
hooks_dir_has_hooks=0
if [ -d "$hooks_dir" ]; then
  for existing in "$hooks_dir"/*; do
    [ -e "$existing" ] || continue
    case "$existing" in
      *.sample) continue ;;
    esac
    hooks_dir_has_hooks=1
    break
  done
fi

configured_hooks_path="$(git config --get core.hooksPath || true)"
if [ -z "$configured_hooks_path" ] && [ "$hooks_dir_has_hooks" -eq 0 ]; then
  git config core.hooksPath .githooks
  echo "install-git-hooks: core.hooksPath -> .githooks"
  exit 0
fi

echo "install-git-hooks: $hooks_dir is owned by another tool — installing forwarders there"
mkdir -p "$hooks_dir"

for tracked in "$tracked_dir"/*; do
  [ -f "$tracked" ] && [ -x "$tracked" ] || continue
  name="$(basename "$tracked")"
  dest="$hooks_dir/$name"

  # Preserve the owning tool's managed block verbatim. beads marks its section
  # "managed by beads. Do not remove these markers" and rewrites between the
  # markers, so carrying it across keeps bd's hook working and keeps bd's own
  # upgrades landing where it expects them.
  managed_block=""
  if [ -e "$dest" ]; then
    managed_block="$(awk -v b="$managed_begin" -v e="$managed_end" \
      'index($0, b) == 1 { inblock = 1 } inblock { print } index($0, e) == 1 { inblock = 0 }' "$dest")"
    if ! grep -q "$forwarder_marker" "$dest"; then
      backup="$dest.pre-gascity-forwarder.$(date -u +%Y%m%dT%H%M%SZ)"
      mv -f "$dest" "$backup"
      echo "install-git-hooks: displaced $dest -> $backup"
    fi
  fi

  {
    cat <<EOF
#!/usr/bin/env bash
# $forwarder_marker .githooks/$name
#
# Generated by scripts/install-git-hooks — do not edit this file. Edit
# .githooks/$name instead; this only chains to it.
#
# core.hooksPath points at this directory because another tool owns it, so git
# will not run the repo's tracked hooks unless something here does.
set -euo pipefail

_fwd_tracked="\$(git rev-parse --show-toplevel)/.githooks/$name"
if [ -x "\$_fwd_tracked" ]; then
  # Arguments and stdin pass through untouched — pre-push reads its ref list
  # from stdin, and a hook that consumed it first would silently disarm the
  # tracked gate. That is why the owning tool's block below runs after this
  # one rather than before it.
  "\$_fwd_tracked" "\$@"
else
  echo >&2 "warning: \$_fwd_tracked is missing or not executable — the tracked $name hook did not run"
fi
EOF
    if [ -n "$managed_block" ]; then
      printf '\n%s\n' "$managed_block"
    fi
  } >"$dest"
  chmod +x "$dest"
  echo "install-git-hooks: $dest -> .githooks/$name"
done
